PORT=5500

# Railway-compatible MySQL variables.
# Local development can use the public proxy host/port exported by Railway.
# On Railway, the service also exposes MYSQLHOST / MYSQLDATABASE / MYSQLUSER / MYSQLPASSWORD.
MYSQL_HOST=your-mysql-host
MYSQL_PORT=3306
MYSQL_DB=your-mysql-database
MYSQL_USER=your-mysql-user
MYSQL_PASS=your-mysql-password
